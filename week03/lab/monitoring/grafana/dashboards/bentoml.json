{
 "uid": "bentoml-income",
 "title": "BentoML income-classifier",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "총 /predict 요청",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(bentoml_service_request_total{endpoint=\"/predict\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "에러 비율 (5분)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.02
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(bentoml_service_request_total{endpoint=\"/predict\",http_response_code!=\"200\"}[5m])) / sum(rate(bentoml_service_request_total{endpoint=\"/predict\"}[5m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p95 지연 (1분)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "처리 중 요청",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(bentoml_service_request_in_progress{endpoint=\"/predict\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "초당 요청 수 (응답 코드별)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (http_response_code) (rate(bentoml_service_request_total{endpoint=\"/predict\"}[1m]))",
     "legendFormat": "{{http_response_code}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "/predict 지연 p50 · p95 · p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(bentoml_service_request_duration_seconds_bucket{endpoint=\"/predict\"}[1m])))",
     "legendFormat": "p99"
    }
   ]
  }
 ]
}